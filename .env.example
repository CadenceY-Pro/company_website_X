# --- Production email for /api/apply (pick ONE path) ---

# Option A (recommended): Resend
# 1) https://resend.com → API Keys
# 2) Vercel → Settings → Environment Variables → Production
RESEND_API_KEY=re_xxxxxxxx
CAREERS_TO_EMAIL=careers@cadencey.io
# Optional after domain is verified in Resend:
# CAREERS_FROM_EMAIL=CadenceY Careers <careers@cadencey.io>

# Option B: Hostinger mailbox SMTP for careers@cadencey.io
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=careers@cadencey.io
SMTP_PASS=your-mailbox-password
