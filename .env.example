# --- Production email for /api/apply ---

# Option A — Hostinger SMTP (fastest way to careers@cadencey.io)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=careers@cadencey.io
SMTP_PASS=your-mailbox-password
CAREERS_TO_EMAIL=careers@cadencey.io

# Option B — Resend
# 1) https://resend.com/api-keys → RESEND_API_KEY
# 2) Until cadencey.io is verified, Resend can ONLY email your Resend login inbox.
#    This API auto-falls back to that inbox when needed.
# 3) Verify domain: https://resend.com/domains → add DNS in Hostinger → then set:
RESEND_API_KEY=re_xxxxxxxx
CAREERS_TO_EMAIL=careers@cadencey.io
# CAREERS_FROM_EMAIL=CadenceY Careers <careers@cadencey.io>
# Optional while domain is pending:
# RESEND_FALLBACK_TO=joyanneesguerra7@gmail.com
